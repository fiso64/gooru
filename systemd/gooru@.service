[Unit]
Description=Gooru instance %i
After=network.target

[Service]
User=gooru-%i
Group=gooru-%i
StateDirectory=gooru-%i
# Gooru provisions its private default uploads directory inside this instance state directory.
StateDirectoryMode=0700
CacheDirectory=gooru-%i
CacheDirectoryMode=0700
WorkingDirectory=/var/lib/gooru-%i
ExecStartPre=/usr/bin/gooru --config /etc/gooru/%i/serve.yaml init --if-missing --hashing-strategy partial
ExecStart=/usr/bin/gooru serve --config /etc/gooru/%i/serve.yaml
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
